{
  "name": "free-chess",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "sun-dev free-chess bun --hot --preload ./css-plugin.ts server.js",
    "dev:server": "bun --hot server/src/index.ts",
    "build": "bun run build:client && bun run build:server",
    "postbuild": "command -v sun-notify >/dev/null 2>&1 && sun-notify free-chess || true",
    "build:client": "bunx vite build --ssrManifest --outDir dist/client",
    "build:server": "bunx vite build --ssr src/entry-server.tsx --outDir dist/server",
    "preview": "NODE_ENV=production bun --preload ./css-plugin.ts server.js",
    "analyze": "ANALYZE=1 bun run build",
    "lint": "bunx oxlint",
    "lint:fix": "bunx oxlint --fix",
    "fmt": "bunx oxfmt \"**/*.{js,jsx,mjs,cjs,ts,tsx,json}\"",
    "fmt:check": "bunx oxfmt --check \"**/*.{js,jsx,mjs,cjs,ts,tsx,json}\"",
    "test": "bunx vitest run --passWithNoTests",
    "test:watch": "bunx vitest",
    "test:coverage": "bunx vitest run --coverage --passWithNoTests"
  },
  "dependencies": {
    "@fastify/compress": "^8.3.1",
    "@fastify/http-proxy": "^11.5.0",
    "@fastify/middie": "^9.3.2",
    "@fastify/static": "^9.1.3",
    "@sun/components": "^0.12.14",
    "@sun/i18n": "^0.1.1",
    "@sun/shared": "^0.2.12",
    "@sun/ssr": "^0.10.0",
    "@sun/themes": "^0.2.10",
    "@sun/utils": "^0.2.0",
    "dotenv": "^16.5.0",
    "fastify": "^5.9.0",
    "i18next": "^25.0.0",
    "lucide-preact": "^1.59.0",
    "preact": "^11.0.1",
    "preact-heroicons": "^2.2.0",
    "preact-render-to-string": "^6.8.1",
    "react-router-dom": "^6.22.0",
    "sirv": "^3.0.1"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@sun/build": "^0.2.1",
    "@types/node": "^25.8.0",
    "@types/react-dom": "^19.1.2",
    "@vitest/coverage-v8": "^3.2.4",
    "bun-types": "1.4.3",
    "jsdom": "^27.0.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "rollup-plugin-visualizer": "^6.0.11",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vitest": "^3.2.4"
  }
}
