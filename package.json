{
  "name": "free-chess",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "sun-dev free-chess bun --hot --preload ./css-plugin.ts server.js",
    "dev:server": "sun-dev free-chess-matchmaking bun --hot server/src/index.ts",
    "restart:server": "command -v sun-notify >/dev/null 2>&1 && sun-notify worker:free-chess-matchmaking || true",
    "deploy": "bun run build && systemctl --user restart sun-app@free-chess.service && systemctl --user restart sun-worker@free-chess-matchmaking.service && command -v sun-notify >/dev/null 2>&1 && sun-notify worker:free-chess-matchmaking || true",
    "build": "bun run build:client && bun run build:server",
    "postbuild": "command -v sun-notify >/dev/null 2>&1 && sun-notify free-chess || true",
    "build:client": "bunx vite build --ssrManifest --outDir dist/client",
    "build:server": "bunx vite build --ssr src/entry-server.tsx --outDir dist/server",
    "preview": "NODE_ENV=production bun --preload ./css-plugin.ts server.js",
    "analyze": "ANALYZE=1 bun run build",
    "lint": "bunx oxlint",
    "typecheck": "bunx tsc --noEmit",
    "lint:fix": "bunx oxlint --fix",
    "fmt": "bunx oxfmt \"**/*.{js,jsx,mjs,cjs,ts,tsx,json}\"",
    "fmt:check": "bunx oxfmt --check \"**/*.{js,jsx,mjs,cjs,ts,tsx,json}\"",
    "test": "bun --bun x vitest run --passWithNoTests",
    "test:watch": "bun --bun x vitest",
    "test:coverage": "bun --bun x vitest run --coverage --passWithNoTests",
    "db:migrate:game": "bun server/scripts/migrate-game.ts",
    "db:game-baseline": "bun server/scripts/game-baseline.ts"
  },
  "dependencies": {
    "@dicebear/core": "^10.7.0",
    "@dicebear/styles": "^10.6.0",
    "@fastify/compress": "^8.3.1",
    "@fastify/formbody": "^9.0.1",
    "@fastify/middie": "^9.3.2",
    "@fastify/static": "^10.1.2",
    "@sun/api": "^0.2.9",
    "@sun/components": "0.12.15",
    "@sun/i18n": "^0.1.1",
    "@sun/shared": "^0.2.12",
    "@sun/ssr": "^0.10.5",
    "@sun/themes": "^0.2.10",
    "@sun/utils": "^0.2.0",
    "cookie": "^1.1.1",
    "dotenv": "^16.5.0",
    "fastify": "^5.9.0",
    "i18next": "^25.0.0",
    "lucide-preact": "^1.59.0",
    "nodemailer": "^10.2.1",
    "preact": "^11.0.1",
    "preact-heroicons": "^2.2.0",
    "preact-render-to-string": "^6.8.1",
    "react-router-dom": "^7.18.0",
    "sirv": "^3.0.1",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/client-preset": "^6.2.3",
    "@graphql-codegen/schema-ast": "^6.1.1",
    "@preact/preset-vite": "^2.10.6",
    "@sun/build": "^0.2.1",
    "@types/node": "^25.8.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react-dom": "^19.1.2",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.12",
    "bun-types": "1.4.3",
    "jsdom": "^27.0.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.85.0",
    "rollup-plugin-visualizer": "^6.0.11",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vitest": "^4.1.12"
  }
}
